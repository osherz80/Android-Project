<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StudentDetailsFragment">

    <ImageView
        android:id="@+id/detailsAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/avatar_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/detailsNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="Name:"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailsAvatar" />

    <TextView
        android:id="@+id/detailsNameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        android:textSize="18sp"
        tools:text="John Doe"
        app:layout_constraintBaseline_toBaselineOf="@id/detailsNameLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailsNameLabel" />

    <TextView
        android:id="@+id/detailsIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ID:"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/detailsNameLabel"
        app:layout_constraintTop_toBottomOf="@id/detailsNameLabel" />

    <TextView
        android:id="@+id/detailsIdValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        android:textSize="18sp"
        tools:text="123456789"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailsIdLabel" />

    <TextView
        android:id="@+id/detailsPhoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Phone:"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/detailsIdLabel"
        app:layout_constraintTop_toBottomOf="@id/detailsIdLabel" />

    <TextView
        android:id="@+id/detailsPhoneValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        android:textSize="18sp"
        tools:text="123-456-7890"
        app:layout_constraintBaseline_toBaselineOf="@id/detailsPhoneLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailsPhoneLabel" />

    <TextView
        android:id="@+id/detailsAddressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Address:"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/detailsIdLabel"
        app:layout_constraintTop_toBottomOf="@id/detailsPhoneLabel" />

    <TextView
        android:id="@+id/detailsAddressValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        android:textSize="18sp"
        tools:text="123 Street Name"
        app:layout_constraintBaseline_toBaselineOf="@id/detailsAddressLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailsAddressLabel" />

    <CheckBox
        android:id="@+id/detailsCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Checked In"
        android:textSize="18sp"
        android:enabled="false"
        app:layout_constraintStart_toStartOf="@id/detailsIdLabel"
        app:layout_constraintTop_toBottomOf="@id/detailsAddressLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>